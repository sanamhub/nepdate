root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,cs}]
indent_size = 4

# Vectors and data tables are tab-separated.
[*.tsv]
indent_style = tab

# Tool output, kept byte for byte.
[docs/benchmarks/raw/**]
trim_trailing_whitespace = false
