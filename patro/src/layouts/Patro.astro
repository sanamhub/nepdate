---
// The patro's page shell: head, header and the valley footer. The tokens, the theme switch and the
// drawings are nepdate.com's (../site), so the two sites look like one family (ADR-0006).
import "../../../site/src/styles/tokens.css";
import "../styles/patro.css";
import ThemeToggle from "../../../web/ThemeToggle.astro";
import { T } from "../lib/i18n";
import { Font } from "astro:assets";
import logo from "../../../site/src/assets/nepdate.svg";
import favicon from "../../../site/public/favicon.svg?url";
import skyline from "../../../site/public/footer-skyline.svg?url";

interface Props {
  title: string;
  description: string;
  /** schema.org data for the page, written as JSON-LD. */
  jsonLd?: object;
  /** A page with the patro app (components/App.astro): it fills the screen and can switch language. */
  app?: boolean;
}
const { title, description, jsonLd, app = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ne" data-theme="light" data-lang="ne" class:list={{ "is-app": app }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FDFBF8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16120E" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NepDate Patro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Font cssVariable="--nd-font-noto-deva" />
    <Font cssVariable="--nd-font-noto" />
    <script is:inline>
      // The same theme rule as nepdate.com, run before paint.
      (() => {
        let stored = "";
        try {
          stored = localStorage.getItem("starlight-theme") || "";
        } catch {}
        const theme = stored || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
      })();
    </script>
    {
      app && (
        <script is:inline>
          // The page is built in Nepali. A visitor who chose English sees the patro once the app has
          // rendered it in English (scripts/app.ts), not a Nepali flash first.
          (() => {
            const root = document.documentElement;
            root.classList.add("js");
            let lang = "";
            try {
              lang = localStorage.getItem("patro-lang") || "";
            } catch {}
            if (lang === "en") {
              root.lang = "en";
              root.dataset.lang = "en";
              root.classList.add("lang-pending");
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main" data-t="skip">मुख्य भागमा जानुहोस्</a>
    <header class="site-header">
      <div class="header-row" class:list={[app ? "wide" : "wrap"]}>
        <a class="brand" href="/">
          <img src={logo.src} width="28" height="28" alt="" />
          <span>पात्रो <span class="brand-en">Patro</span></span>
        </a>
        <div class="header-tools">
          <a class="powered" href="https://nepdate.com/" aria-label="Powered by NepDate, nepdate.com">
            <span class="powered-by">Powered by</span>
            <img src={logo.src} width="18" height="18" alt="" />
            <b>NepDate</b>
          </a>
          {
            app && (
              <div class="lang" role="group" aria-label="भाषा, Language">
                <button type="button" data-lang="ne" aria-pressed="true" lang="ne">
                  <svg class="flag" viewBox="0 0 12 15" width="12" height="15" aria-hidden="true">
                    <path d="M.6.6 11 7.3H4.6L11 14.4H.6Z" fill="#DC143C" stroke="#003893" stroke-width="1.1" stroke-linejoin="round" />
                    <path d="M2.2 4.6a1.6 1.6 0 0 0 3 0 1.4 1.1 0 0 1-3 0Z" fill="#fff" />
                    <circle cx="3.6" cy="11" r="1.25" fill="#fff" />
                  </svg>
                  <span>नेपाली</span>
                </button>
                <button type="button" data-lang="en" aria-pressed="false" lang="en">
                  <svg class="flag" viewBox="0 0 60 30" width="22" height="12" aria-hidden="true">
                    <clipPath id="uk-flag"><path d="M30 15h30v15zv15H0zH0V0zV0h30z" /></clipPath>
                    <path d="M0 0v30h60V0z" fill="#012169" />
                    <path d="m0 0 60 30m0-30L0 30" stroke="#fff" stroke-width="6" />
                    <path d="m0 0 60 30m0-30L0 30" clip-path="url(#uk-flag)" stroke="#C8102E" stroke-width="4" />
                    <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
                    <path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6" />
                  </svg>
                  <span>English</span>
                </button>
              </div>
            )
          }
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" style={`--skyline: url("${skyline}")`}>
      <div class="wrap footer-row">
        {
          app ? (
            <>
              <p data-t-html="footerNote" set:html={T.ne.footerNote} />
              <p><a href="https://github.com/sanamhub/nepdate/issues/new/choose" data-t="footerReport">{T.ne.footerReport}</a></p>
            </>
          ) : (
            <>
              <p set:html={T.en.footerNote} />
              <p><a href="https://github.com/sanamhub/nepdate/issues/new/choose">{T.en.footerReport}</a></p>
            </>
          )
        }
      </div>
      <div class="footer-art" aria-hidden="true"></div>
      <div class="footer-base"><div class="wrap">© {year} NepDate contributors</div></div>
    </footer>
  </body>
</html>
