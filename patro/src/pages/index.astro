---
// The home page: this month in Nepal. It is built with the month of the build day; in the browser
// the app (components/App.astro) shows the month of today in Nepal.
import { NepaliDate } from "nepdate-core";
import Patro from "../layouts/Patro.astro";
import App from "../components/App.astro";

const today = NepaliDate.today();
const title = "नेपाली पात्रो: आजको मिति, तिथि र बिदा | NepDate Patro";
const description =
  "The Nepali calendar (Bikram Sambat) with tithi, paksha, public holidays and events for every day, and the AD date beside each. In Nepali and English. Fast, clean, no ads.";
// The site, and the project behind it: the same Organization as nepdate.com, so agents can tie the
// two hosts together and find the contact page.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "NepDate Patro",
      url: "https://patro.nepdate.com/",
      description,
      inLanguage: ["ne", "en"],
      publisher: { "@id": "https://nepdate.com/#org" },
    },
    {
      "@type": "Organization",
      "@id": "https://nepdate.com/#org",
      name: "NepDate",
      url: "https://nepdate.com/",
      logo: "https://nepdate.com/favicon.svg",
      sameAs: ["https://github.com/sanamhub/nepdate"],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "technical support",
        url: "https://nepdate.com/contact/",
        availableLanguage: ["English", "Nepali"],
      },
    },
  ],
};
---

<Patro title={title} description={description} jsonLd={jsonLd} app>
  <App year={today.year} month={today.month} home />
</Patro>
