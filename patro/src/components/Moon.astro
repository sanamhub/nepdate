---
// The moon on a day, drawn from its tithi (styles in patro.css). The lit share grows through the
// shukla paksha to Purnima and shrinks through the krishna paksha to Aunsi.
import type { Tithi } from "../lib/patro";

interface Props {
  tithi: Tithi;
}
const { tithi } = Astro.props;
const lit = tithi.paksha === "shukla" ? tithi.number / 15 : 1 - tithi.number / 15;
const shape = lit >= 1 ? "full" : lit <= 0 ? "new" : lit < 0.5 ? "crescent" : "gibbous";
const ellipse = `${Math.round(Math.abs(1 - 2 * lit) * 100)}%`;
---

<i class:list={["moon", tithi.paksha === "shukla" ? "waxing" : "waning", shape]} style={`--ellipse:${ellipse}`} aria-hidden="true"
></i>
