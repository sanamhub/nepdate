// patro.nepdate.com (ADR-0006, ADR-0010): the static files Astro builds into dist/, served by a
// Cloudflare Worker whose only code (worker.js) picks Markdown or JSON for agents, like nepdate.com
// (site/wrangler.jsonc). Workers Builds runs
// `npm ci && npm run build` in patro/ and `npx wrangler deploy` on main; pull requests get previews.
{
  "name": "nepdate-patro",
  "compatibility_date": "2026-10-01",
  // ADR-0010: page requests go through worker.js, which serves Markdown or a JSON error to agents
  // that ask for them; every other file goes straight to the static assets.
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/pagefind/*",
      "!/*.css",
      "!/*.js",
      "!/*.svg",
      "!/*.png",
      "!/*.ico",
      "!/*.woff2",
      "!/*.txt",
      "!/*.xml",
      "!/*.ics",
      "!/*.webmanifest"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "patro.nepdate.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "previews": {},
  "preview_urls": true,
  "observability": { "enabled": false }
}
