<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates spec/vectors/csharp-golden/*.tsv from the published NepDate NuGet package.
       Run from repo root (see tools/README.md), or use tools/csharp-golden/regenerate.sh.
       net10.0 because the serialization rows use the System.Text.Json version the package
       references. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NepDate" Version="2.0.7" />
  </ItemGroup>
</Project>
