<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# NepDate baseline for spec/BENCHMARK.md (B1 to B8). See README.md in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same version as tools/csharp-golden. Changing it is a human decision. -->
    <PackageReference Include="NepDate" Version="2.0.7" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- Other C# BS converters on nuget.org, measured on B1 and B2 only (Competitors.cs). -->
    <PackageReference Include="NepaliCalendarBS" Version="1.2.3" />
    <!-- Only ships a net45 assembly; it loads fine on .NET 8 and 10, so the fallback warning is expected. -->
    <PackageReference Include="NepaliDateConverter.Net" Version="2.0.1" NoWarn="NU1701" />
    <PackageReference Include="NepaliDateConverter.NETCORE" Version="1.0.4" />
    <PackageReference Include="NepaliCalendarToolkit" Version="2.0.2" />
    <PackageReference Include="BSDateConverter" Version="1.3.0" />
    <PackageReference Include="BsadConverter" Version="1.1.0" />
    <PackageReference Include="NepaliUtility.Core" Version="1.0.2" />
    <PackageReference Include="OSN.NepaliCalendar" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The 64 dates come from the hub's canonical month lengths, not from NepDate. -->
    <EmbeddedResource Include="..\..\data\calendar\bs-calendar.json" LogicalName="bs-calendar.json" />
  </ItemGroup>
</Project>
