---
import { Code } from "astro:components";
import { NepaliDate, toNepaliDigits, monthName } from "nepdate-core";
import { info } from "nepdate-patro";
import Landing from "../layouts/Landing.astro";
import "../styles/hero-motion.css";
// Everything below the hero is styled by this sheet, linked in the body (see landing-sections.css).
import sectionsCss from "../styles/landing-sections.css?url";
import MitiBarArt from "../components/landing/MitiBarArt.astro";
import MonthLengths from "../components/landing/MonthLengths.astro";
import LangIcon from "../components/landing/LangIcon.astro";
import { downloads, formatCount } from "../data/downloads";
import { competitorCount, formatNs, languages, nearest } from "../data/benchmarks";
import { DATA_ERROR_FORM, HUB, MITIBAR_RELEASE, MITIBAR_VERSION, PATRO, ports, repoUrl, versionLine } from "../data/ports";
import { registryId } from "../data/lang-icons";
import mitibarIcon from "../assets/mitibar-icon.png";
import nepdateMark from "../assets/nepdate.svg";

// Rendered at build time so the page reads right without JavaScript; the script in
// scripts/landing.ts replaces it with the visitor's own "today in Nepal" on load.
const today = NepaliDate.today();
const todayAd = today.toGregorian();
const adLong = new Intl.DateTimeFormat("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(
  new Date(Date.UTC(todayAd.year, todayAd.month - 1, todayAd.day)),
);
// The AD date the hero's opening sequence starts from, before it resolves into the BS date.
const adPlain = `${todayAd.day} ${new Intl.DateTimeFormat("en-GB", { month: "long", timeZone: "UTC" }).format(
  new Date(Date.UTC(todayAd.year, todayAd.month - 1, todayAd.day)),
)} ${todayAd.year}`;

// The patro strip: the first Sunday-to-Saturday week from today that has a public holiday, read
// from nepdate-patro at build time and labelled with its dates.
function holidayWeek(from: NepaliDate) {
  let start = from.addDays(-from.weekday);
  for (let i = 0; i < 26; i++) {
    const days = Array.from({ length: 7 }, (_, n) => start.addDays(n));
    if (days.some((d) => info(d).isPublicHoliday)) return days;
    start = start.addDays(7);
  }
  return Array.from({ length: 7 }, (_, n) => from.addDays(-from.weekday + n));
}
// The converter's day line starts with today's tithi, holiday and events; the script refreshes it
// for each date the visitor picks.
const todayInfo = info(today);

const week = holidayWeek(today).map((d) => {
  const ad = d.toGregorian();
  const day = info(d);
  return {
    key: d.toJSON(),
    bs: toNepaliDigits(d.day),
    ad: ad.day,
    weekday: d.long({ weekday: true, year: false, pad: false }).split(",")[0],
    tithi: day.tithi,
    holiday: day.isPublicHoliday,
    event: day.events[0] ?? null,
  };
});
const weekFirst = holidayWeek(today)[0];
const weekLast = holidayWeek(today)[6];
const weekLabel =
  weekFirst.month === weekLast.month
    ? `${monthName(weekFirst.month)} ${weekFirst.day} to ${weekLast.day}, ${weekLast.year}`
    : `${weekFirst.long({ year: false, pad: false })} to ${weekLast.long({ pad: false })}`;

// The hero's result line: each port's own BS to AD time, from the same benchmark reports.
const callTime = (id: string) => formatNs(languages.find((b) => b.id === id)!.ops[0]);

// The speed section: each language's BS to AD time against the fastest other library in it. Where
// that library is within 1.5 times NepDate, the row says so and how many dates it gets wrong.
const race = languages.map((port) => {
  const next = nearest(port);
  if (next === null) {
    return {
      id: port.id,
      name: port.name,
      ours: formatNs(port.ops[0]),
      theirs: "",
      rival: "",
      wrong: 0,
      times: "",
      none: true,
      width: "0",
    };
  }
  return {
    id: port.id,
    name: port.name,
    ours: formatNs(next.ours),
    theirs: formatNs(next.b1),
    rival: next.name,
    wrong: next.wrong,
    none: false,
    times:
      next.times < 1.5
        ? "As fast"
        : `${next.times < 10 ? next.times.toFixed(1) : Math.round(next.times).toString()}× faster`,
    width: Math.min(100, Math.max(1, (next.ours / next.b1) * 100)).toFixed(1),
  };
});

const title = "NepDate: fast Nepali dates for every language you ship";
const languageList = new Intl.ListFormat("en", { type: "conjunction" }).format(ports.map((port) => port.name));
const description = `Bikram Sambat (BS) date libraries for ${languageList}, built from one dataset and one spec so every language gives the same answer. Plus MitiBar, a Nepali calendar for your desktop, and a free online patro.`;

// The strip near the end of the page: every language, then where the apps run. Two copies scroll as one loop.
const strip = [
  ...ports.map((port) => ({ id: port.id, label: port.name })),
  { id: "windows", label: "Windows" },
  { id: "macos", label: "macOS" },
  { id: "linux", label: "Linux" },
  { id: "android", label: "Android" },
  { id: "ios", label: "iOS" },
];

// What search and answer engines read about the page: the site, the libraries and the app. Kept
// short: the page must stay inside the first network round trip. llms.txt has the install lines.
const site = Astro.site?.href ?? "https://nepdate.com/";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site}#site`, name: "NepDate", url: site, description },
    {
      "@type": "SoftwareSourceCode",
      name: "NepDate",
      programmingLanguage: ports.map((port) => port.name),
      codeRepository: HUB,
      license: "MIT",
    },
    {
      "@type": "SoftwareApplication",
      name: "MitiBar",
      description: "Today's Bikram Sambat date in the tray and taskbar, with a month calendar, tithi and public holidays.",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Windows, macOS, Linux",
      downloadUrl: MITIBAR_RELEASE,
      softwareVersion: MITIBAR_VERSION,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
  ],
};
---

<Landing title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="patro-sheet" aria-hidden="true">
      <span>आइत</span><span>सोम</span><span>मङ्गल</span><span>बुध</span><span>बिहि</span><span>शुक्र</span><span>शनि</span>
    </div>
    <div class="wrap hero-grid">
      <div class="hero-object" data-tabs>
        <div class="object-date">
          <p class="today-label">Today in Nepal</p>
          <p class="today" data-today>
            <span class="today-ad" aria-hidden="true" data-today-ad>{adPlain}</span>
            <span class="part part-month" lang="ne" data-today-month>{monthName(today.month, "ne")}</span>
            <span class="part part-day today-day" lang="ne" data-today-day>{toNepaliDigits(today.day)}</span>
            <span class="part part-year" lang="ne" data-today-year>{toNepaliDigits(today.year)}</span>
          </p>
          <p class="today-en" data-today-en>
            {adLong} is {today.long({ weekday: false, pad: false })}.
          </p>
        </div>
        <div class="tabs" role="tablist" aria-label="Language">
          {
            ports.map((port, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${port.id}`}
                aria-controls={`panel-${port.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                title={port.name}
                aria-label={port.name}
              >
                <LangIcon id={port.id} size={17} brand />
                <span class="tab-name">{port.name}</span>
              </button>
            ))
          }
        </div>
        {
          ports.map((port, i) => (
            <div role="tabpanel" id={`panel-${port.id}`} aria-labelledby={`tab-${port.id}`} hidden={i !== 0} tabindex="0">
              <Code code={port.sample} lang={port.lang as any} themes={{ light: "github-light-default", dark: "github-dark-default" }} />
              <p class="code-foot">
                <span>
                  BS 2081-04-15 is <span class="resolve">AD 2024-07-30</span>
                </span>
                <span>{callTime(port.id)} per call in {port.name}</span>
              </p>
            </div>
          ))
        }
      </div>

      <div class="hero-copy">
        <h1>Nepali dates in nanoseconds, the same in every language.</h1>
        <p class="lede">
          Bikram Sambat libraries for {ports.length} languages, built from one dataset and one spec. Every one gives the
          same day for any date from BS 1901 to 2199, and it matches or beats the most-used library in each language
          that has one.
        </p>
        <div class="actions">
          <a class="button primary" href="/docs/quickstart/">Get started</a>
          <nav class="app-links" aria-label="Apps">
            <a href={PATRO}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
                ><rect x="3.5" y="5" width="17" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"
                ></rect><path d="M3.5 10h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                ></path><circle cx="15.5" cy="15" r="1.6" fill="var(--nd-sindoor)"></circle></svg
              >
              <span>Patro <small>web</small></span>
            </a>
            <a href="/mitibar/">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
                ><rect x="3" y="4" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"
                ></rect><path d="M8 20.5h8M12 17v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                ></path><rect x="11" y="12" width="7" height="2.6" rx="1.3" fill="var(--nd-sindoor)"></rect></svg
              >
              <span>MitiBar <small>desktop</small></span>
            </a>
          </nav>
        </div>
      </div>
    </div>
  </section>

  <link rel="stylesheet" href={sectionsCss} />
  <section class="section" id="languages" aria-labelledby="languages-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="languages-title">Install in your language</h2>
        <p>
          Each language ships two packages on the <code>{versionLine}</code> line: the core for conversion, arithmetic,
          formatting and parsing, and the patro for tithi, public holidays and events. Install only the core and no
          almanac data ships with your app. C# NepDate is one package with its own versions.
        </p>
      </div>
      <div class="install" data-tabs>
        <div class="lang-grid" role="tablist" aria-label="Language">
          {
            ports.map((port, i) => (
              <button
                type="button"
                role="tab"
                class="lang-tile"
                id={`install-tab-${port.id}`}
                aria-controls={`install-${port.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                <LangIcon id={port.id} size={30} brand />
                <span>{port.name}</span>
              </button>
            ))
          }
        </div>
        {
          ports.map((port, i) => (
            <div
              class="lang"
              role="tabpanel"
              id={`install-${port.id}`}
              aria-labelledby={`install-tab-${port.id}`}
              hidden={i !== 0}
            >
              <LangIcon id={port.id} size={220} brand class="lang-watermark" />
              <div class="lang-id">
                <h3 class="lang-name">{port.name}</h3>
                {downloads[port.id] && (
                  <p class="lang-count" title={`${downloads[port.id].registry}, ${downloads[port.id].span}`}>
                    {formatCount(downloads[port.id].count)} downloads
                  </p>
                )}
              </div>
              <div class="lang-cmds">
                <div class="install-cmd">
                  <span class="install-kind">Core</span>
                  <code translate="no">{port.install}</code>
                  <button type="button" class="copy" data-copy={port.install} aria-label={`Copy ${port.name} core`}>
                    Copy
                  </button>
                </div>
                {port.patroInstall ? (
                  <div class="install-cmd">
                    <span class="install-kind">Patro</span>
                    <code translate="no">{port.patroInstall}</code>
                    <button type="button" class="copy" data-copy={port.patroInstall} aria-label={`Copy ${port.name} patro`}>
                      Copy
                    </button>
                  </div>
                ) : (
                  <p class="install-same">The patro is part of the same package.</p>
                )}
              </div>
              <div class="lang-links">
                <a class="chip" href={`/docs/${port.id}/`}>
                  <LangIcon id="guide" size={16} />
                  Guide<span class="visually-hidden"> for {port.name}</span>
                </a>
                <a class="chip" href={port.registry.href}>
                  <LangIcon id={registryId(port.registry.label)} size={16} brand />
                  {port.registry.label}
                </a>
                <a class="chip" href={repoUrl(port)}>
                  <LangIcon id="source" size={16} />
                  Source<span class="visually-hidden"> of {port.name}</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
      <p class="note">
        Download counts come from {Object.values(downloads).map((d) => `${d.registry} (${d.span})`).join(", ")}, read when
        this page was built. Go, SwiftPM, Maven Central and CMake publish no counts.
      </p>
    </div>
  </section>

  <section class="section band speed" id="performance" aria-labelledby="speed-title">
    <div class="wrap">
      <div class="section-head speed-head">
        <h2 id="speed-title">Fast, and right, in every language</h2>
        <p>
          BS to AD, time per call, against the fastest other Bikram Sambat library where a language
          has a mature one. We timed {competitorCount} other libraries. None of them agrees with the
          calendar data on all 64 dates, and in those languages NepDate is faster than all of them on
          both conversions.
        </p>
      </div>
      <ol class="panel race">
        {
          race.map((row) => (
            <li>
              <span class="race-lang">
                <LangIcon id={row.id} size={16} brand />
                {row.name}
              </span>
              <span class="race-track" aria-hidden="true">
                <span class="race-bar theirs" style="--w: 100%" />
                <span class="race-bar ours" style={`--w: ${row.width}%`} />
              </span>
              <span class="race-nums">
                <strong>{row.ours}</strong>
                {row.none ? (
                  <span class="race-vs"> no mature library to compare</span>
                ) : (
                  <>
                    <span class="race-vs"> against {row.theirs} for </span>
                    <code class="who">{row.rival}</code>
                    {row.wrong ? <span class="race-note">It is wrong on {row.wrong} of the 64 dates.</span> : null}
                  </>
                )}
              </span>
              {row.none ? null : <span class="race-times">{row.times}</span>}
            </li>
          ))
        }
      </ol>
      <a class="text-link" href="/docs/project/performance/">Every operation, and how it was measured</a>
    </div>
  </section>

  <section class="section convert" id="convert" aria-labelledby="convert-title">
    <div class="convert-numerals" aria-hidden="true">
      <span lang="ne">{toNepaliDigits(today.year)}</span>
      <span>{todayAd.year}</span>
    </div>
    <div class="wrap convert-grid">
      <div class="section-head">
        <h2 id="convert-title">Convert a date</h2>
        <p>
          This runs <a href="/docs/typescript/"><code>nepdate-core</code></a> in your browser, with the{" "}
          <a href="/docs/datepicker/">date picker</a> for the BS field. Type a BS date in numbers or with the month
          name, choose it from the calendar, or pick an AD date.
        </p>
      </div>
      <form class="panel converter" data-converter novalidate>
        <div class="field">
          <label for="bs-input">Bikram Sambat</label>
          <nepdate-input
            id="bs-input"
            name="bs"
            placeholder="2081/04/15 or 15 Shrawan 2081"
            value={today.toJSON()}
            show-gregorian></nepdate-input>
          <p class="result" aria-live="polite" data-bs-result></p>
        </div>
        <svg class="art convert-art" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path class="art-line" d="M8 15h22M24 9l6 6-6 6M32 25H10M16 19l-6 6 6 6"></path>
        </svg>
        <div class="field">
          <label for="ad-input">Gregorian (AD)</label>
          <div class="ad-field" data-ad-field>
            <input
              id="ad-input"
              name="ad"
              type="date"
              min="1844-04-11"
              max="2143-04-15"
              value={`${todayAd.year}-${String(todayAd.month).padStart(2, "0")}-${String(todayAd.day).padStart(2, "0")}`}
            />
            <button type="button" class="ad-button" aria-label="Choose an AD date" hidden data-ad-button>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                aria-hidden="true"
                focusable="false"
                ><rect x="3.5" y="5" width="17" height="15" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"
                ></path></svg
              >
            </button>
            <div class="ad-cal" role="dialog" aria-label="Choose an AD date" hidden data-ad-cal></div>
          </div>
          <p class="result" aria-live="polite" data-ad-result></p>
        </div>
        <div class="day-info" aria-live="polite" data-day-info>
          <p class="day-tithi">
            <span class="day-label">Tithi</span>
            <span>{todayInfo.tithi ? `${todayInfo.tithi.en}, ` : "Not in the patro data"}{todayInfo.tithi && <span lang="ne">{todayInfo.tithi.np}</span>}</span>
          </p>
          <p class="day-holiday">
            <span class="day-label">Holiday</span>
            <span class:list={[{ "is-holiday": todayInfo.isPublicHoliday }]}>{todayInfo.isPublicHoliday ? "Public holiday" : "Not a public holiday"}</span>
          </p>
          <p class="day-events">
            <span class="day-label">Events</span>
            <span>{todayInfo.events.length ? todayInfo.events.map((e) => e.en).join(", ") : "None listed"}</span>
          </p>
        </div>
      </form>
    </div>
  </section>

  <section class="section patro" aria-labelledby="patro-title">
    <svg class="moons" viewBox="0 0 640 40" aria-hidden="true" focusable="false">
      {
        Array.from({ length: 15 }, (_, i) => {
          const x = 20 + i * 43;
          const lit = (i + 1) / 15;
          return (
            <g>
              <circle cx={x} cy="20" r="13" class="moon-dark" />
              <path
                class="moon-lit"
                d={`M${x} 7a13 13 0 0 1 0 26a${Math.abs(13 * (1 - 2 * lit)).toFixed(2)} 13 0 0 ${lit > 0.5 ? 1 : 0} 0 -26`}
              />
            </g>
          );
        })
      }
    </svg>
    <div class="wrap">
      <div class="section-head">
        <h2 id="patro-title">The patro, in its own package</h2>
        <p>
          Tithi, public holidays and events for BS 2077 to 2084 come from <code>nepdate-patro</code> and its twins in
          every language. Below, {weekLabel}, read from it when this page was built.
        </p>
      </div>
      <ol class="panel week" aria-label={`Week of ${weekLabel}`}>
        {
          week.map((d) => (
            <li class:list={[{ holiday: d.holiday }]}>
              <span class="week-day">{d.weekday}</span>
              <span class="week-num" lang="ne">
                {d.bs}
                {d.event && <span class="dot" aria-hidden="true" />}
              </span>
              <span class="week-ad">{d.ad}</span>
              <span class="week-tithi">{d.tithi?.en ?? ""}</span>
              {d.event && <span class="week-event">{d.event.en}</span>}
              {d.holiday && <span class="visually-hidden">Public holiday</span>}
            </li>
          ))
        }
      </ol>
      <p class="note">Holidays in red, events marked with a dot. Patro data is informational, not an official calendar.</p>
      <div class="patro-cta">
        <a class="button primary" href={PATRO}>Open patro.nepdate.com</a>
        <p>
          Every month with tithi, holidays and events, a page for each day, and each year's holidays for your calendar
          app. Built from these same packages.
        </p>
      </div>
    </div>
  </section>

  <section class="section band proof" aria-labelledby="proof-title">
    <div class="wrap proof-grid">
      <div>
        <div class="section-head">
          <h2 id="proof-title">Every day from 1901 to 2199, tested in every language</h2>
          <p>
            The calendar data and the expected answers live once, in the <a href={HUB}>hub repository</a>. Each port
            builds its tables from that copy, fails its build when the copy drifts, and runs the same test files in its
            own CI.
          </p>
          <a class="text-link" href="/docs/project/conformance/">How the ports are kept in step</a>
        </div>
      </div>
      <MonthLengths today={today} />
    </div>
    <div class="wrap">
      <dl class="facts">
        <div>
          <dt><span class="num">109,212</span> days</dt>
          <dd>Every day in the range, converted to AD and back in every port.</dd>
        </div>
        <div>
          <dt><span class="num">7,176</span> month boundaries</dt>
          <dd>The first and last day of every BS month from 1901 to 2199.</dd>
        </div>
        <div>
          <dt><span class="num">20,360</span> golden rows</dt>
          <dd>Dates, added days and added months, recorded from C# NepDate 2.0.7.</dd>
        </div>
        <div>
          <dt><span class="num">0</span> port-only differences</dt>
          <dd>Where a port differs from C#, every port differs the same way, and it is written down.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section apps" id="mitibar" aria-labelledby="apps-title">
    <div class="wrap apps-grid">
      <MitiBarArt today={today} />
      <div class="section-head">
        <h2 id="apps-title">MitiBar</h2>
        <p>
          Today's BS date in the tray, a month with tithi and holidays one click away, and on Windows a small bar with
          the date and time wherever you put it. Win+Shift+N opens it. No network requests.
        </p>
        <div class="actions">
          <a class="button primary" href="/mitibar/">Get MitiBar</a>
          <span class="os-marks" role="img" aria-label="Windows, macOS and Linux">
            <LangIcon id="windows" size={20} brand />
            <LangIcon id="macos" size={20} brand />
            <LangIcon id="linux" size={20} brand />
          </span>
        </div>
        <p class="note">Free for Windows, macOS and Linux. Not code-signed yet; the release notes say how to open and verify it.</p>
        <div class="phone">
          <h3>
            <span class="os-marks" aria-hidden="true">
              <LangIcon id="android" size={20} brand />
              <LangIcon id="macos" size={20} brand />
            </span>
            On your phone <span class="soon">Coming soon</span>
          </h3>
          <p>
            NepDate for Android and iOS: home-screen widgets, the month with tithi and holidays, and no ads, account or
            network. <a href="/docs/apps/mobile/">Follow along</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="strip" aria-label="Languages and platforms">
    <div class="strip-track">
      {
        [0, 1].map((copy) => (
          <ul class="strip-run" aria-hidden={copy === 1 ? "true" : undefined}>
            {strip.map((item) => (
              <li>
                <LangIcon id={item.id} size={22} brand />
                {item.label}
              </li>
            ))}
            <li>
              <img src={nepdateMark.src} width="22" height="22" alt="" />
              Patro
            </li>
            <li>
