---
// The landing page shell: head, header and footer. The docs use Starlight's own shell; both read
// the same theme choice from localStorage ("starlight-theme"), so switching on one page holds on
// the other.
import "../styles/tokens.css";
import "nepdate-datepicker/theme.css";
import "../styles/landing.css";
import Fonts from "../components/Fonts.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import logo from "../assets/nepdate.svg";
import { HUB, DATA_ERROR_FORM, ports } from "../data/ports";

interface Props {
  title: string;
  description: string;
  /** schema.org data for the page, written as JSON-LD. */
  jsonLd?: object;
}
const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FDFBF8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16120E" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NepDate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Fonts />
    <script is:inline>
      // Same key and rule as Starlight's ThemeProvider, run before paint.
      (() => {
        let stored = "";
        try {
          stored = localStorage.getItem("starlight-theme") || "";
        } catch {}
        const theme = stored || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="NepDate home">
          <img src={logo.src} width="28" height="28" alt="" />
          <span>NepDate</span>
        </a>
        <nav aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href="/#languages">Languages</a>
          <a href="/#performance">Performance</a>
          <a href="/docs/apps/mitibar/">MitiBar</a>
          <a class="icon-link" href={HUB} aria-label="NepDate on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
          </a>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <img src={logo.src} width="24" height="24" alt="" />
            <span>NepDate</span>
          </a>
          <p>
            Calendar data and algorithm from <a href="https://github.com/RajuPrasai/NepDate">NepDate</a> by Raju Prasai
            and contributors. MIT licensed. Not affiliated with the Government of Nepal; holiday data is informational.
          </p>
        </div>
        <div>
          <h2>Docs</h2>
          <ul>
            <li><a href="/docs/">Introduction</a></li>
            <li><a href="/docs/quickstart/">Quick start</a></li>
            <li><a href="/docs/concepts/calendar/">The calendar</a></li>
            <li><a href="/docs/project/data/">Data and credits</a></li>
          </ul>
        </div>
        <div>
          <h2>Languages</h2>
          <ul>
            {
              ports.map((port) => (
                <li>
                  <a href={`/docs/${port.id}/`}>
                    {port.name}
                    <span class="visually-hidden"> docs</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li><a href={HUB}>GitHub</a></li>
            <li><a href="/docs/project/performance/">Performance</a></li>
            <li><a href="/docs/apps/mitibar/">MitiBar</a></li>
            <li><a href={DATA_ERROR_FORM}>Report a wrong date</a></li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-base">
        <span>© {year} NepDate contributors</span>
      </div>
    </footer>
  </body>
</html>
