---
// One calendar dataset feeding every port: a data sheet on the left, a line to each language on
// the right, and the same tick in every box because every port gives the same answer. The drawing
// is aria-hidden; the section text says this in words. Repeated shapes are joined into single
// paths and a pattern so the drawing stays small in the page's HTML.
import { ports } from "../../data/ports";

const rowY = (i: number) => 10 + i * 15;
const fan = ports.map((_, i) => `M74 66C128 66 132 ${rowY(i) + 6} 178 ${rowY(i) + 6}`).join("");
const ticks = ports.map((_, i) => `M181 ${rowY(i) + 6.5}l2.2 2.2 4-4.6`).join("");
---

<svg class="art ports-art" viewBox="0 0 300 132" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="ports-box" x="178" y="10" width="12" height="15" patternUnits="userSpaceOnUse">
      <rect class="art-line" x="0.6" y="0.6" width="10.8" height="10.8" rx="3"></rect>
    </pattern>
  </defs>
  <rect class="art-line" x="14" y="30" width="60" height="72" rx="6"></rect>
  <path class="art-line" d="M14 44h60"></path>
  <path class="art-line faint" d="M22 54h44M22 63h30M22 72h44M22 81h30M22 90h44"></path>
  <path class="art-line faint" d={fan}></path>
  <rect x="178" y="10" width="12" height={ports.length * 15} fill="url(#ports-box)"></rect>
  <path class="art-ink" d={ticks}></path>
  <text class="art-text">
    {ports.map((port, i) => <tspan x="198" y={rowY(i) + 9.5}>{port.name}</tspan>)}
  </text>
</svg>
