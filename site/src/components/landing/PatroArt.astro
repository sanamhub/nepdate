---
// Tithi follow the moon: seven moons waxing from new to full, as a patro week runs, and one sindoor
// dot under a day the way MitiBar marks a public holiday. Decorative; the week below is the data.
// The outlines are one pattern and the lit parts one path, so the drawing stays small.
const r = 10;
const gap = 34;
const cy = 22;
const lit = Array.from({ length: 7 }, (_, i) => {
  const f = (i + 0.5) / 7;
  const cx = 18 + i * gap;
  const rx = (Math.abs(1 - 2 * f) * r).toFixed(1);
  return `M${cx} ${cy - r}A${r} ${r} 0 0 1 ${cx} ${cy + r}A${rx} ${r} 0 0 ${f < 0.5 ? 0 : 1} ${cx} ${cy - r}Z`;
}).join("");
---

<svg class="art patro-art" viewBox="0 0 240 52" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="patro-moon" width={gap} height="52" patternUnits="userSpaceOnUse">
      <circle class="art-line" cx="18" cy={cy} r={r}></circle>
    </pattern>
  </defs>
  <rect width="240" height="40" fill="url(#patro-moon)"></rect>
  <path class="art-fill" d={lit}></path>
  <circle class="art-sindoor" cx={18 + 4 * gap} cy="44" r="2.5"></circle>
</svg>
