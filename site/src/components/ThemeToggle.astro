---
// The light and dark switch, shared by the landing header and the docs header (it replaces
// Starlight's theme select, so both pages offer the same control). The choice is stored under
// Starlight's key, so either page opens in the theme last picked on the other.
---

<button class="theme-toggle" type="button" aria-label="Switch between light and dark theme">
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
    ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
    ></path></svg
  >
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
    ><path
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg
  >
</button>

<script>
  import "../scripts/theme";
</script>
