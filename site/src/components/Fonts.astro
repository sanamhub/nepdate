---
// The MitiBar fonts (nepdate-rust ADR-0010): Noto Sans for Latin, Noto Sans Devanagari for Nepali,
// JetBrains Mono for code. Self-hosted from the fontsource packages through Astro's font API, which
// writes metric-matched fallbacks. A first visit paints with the system's fonts and fetches these
// once the page is idle (web/FontLoader.astro), so none is preloaded. Each family carries one
// subset (fonts.mjs); rarer Latin letters use the metric-matched system fallback.
import { Font } from "astro:assets";
import FontLoader from "../../../web/FontLoader.astro";
---

<Font cssVariable="--nd-font-noto-deva" />
<Font cssVariable="--nd-font-noto" />
<Font cssVariable="--nd-font-jetbrains" />
<FontLoader storageKey="nepdate-fonts" />
