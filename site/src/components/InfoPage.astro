---
// A plain reading page in the landing shell: About, Contact and Privacy. One column of prose at a
// reading width, the page title as the only h1.
import Landing from "../layouts/Landing.astro";
import "../styles/info.css";
// The footer (and its valley drawing) is styled by this sheet, linked in the body as on the
// landing and MitiBar pages.
import sectionsCss from "../styles/landing-sections.css?url";

interface Props {
  title: string;
  heading: string;
  description: string;
  /** schema.org data for the page (AboutPage, ContactPage, WebPage). */
  jsonLd?: object;
}
const { title, heading, description, jsonLd } = Astro.props;
---

<Landing title={title} description={description} jsonLd={jsonLd}>
  <article class="info wrap" aria-labelledby="info-title">
    <h1 id="info-title">{heading}</h1>
    <slot />
  </article>
  <link rel="stylesheet" href={sectionsCss} />
</Landing>
